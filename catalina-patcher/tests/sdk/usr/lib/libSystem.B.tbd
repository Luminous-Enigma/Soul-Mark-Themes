--- !tapi-tbd-v3
archs:           [ x86_64 ]
platform:        macosx
install-name:    '/usr/lib/libSystem.B.dylib'
exports:
  - archs:           [ x86_64 ]
    re-exports:      [ '/usr/lib/system/libsystem_malloc.dylib' ]
    symbols:         [ _mach_task_self_ ]
--- !tapi-tbd-v3
archs:           [ x86_64 ]
platform:        macosx
install-name:    '/usr/lib/system/libsystem_malloc.dylib'
exports:
  - archs:           [ x86_64 ]
    symbols:         [ _malloc, _free ]
...
