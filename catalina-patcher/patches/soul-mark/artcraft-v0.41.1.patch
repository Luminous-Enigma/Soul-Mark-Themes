+  html[data-glass] .bg-background,
+  html[data-glass] [class*="bg-ui-panel"],
+  html[data-glass] [class*="bg-ui-modal"],
+  html[data-glass] .bg-sidebar,
+  html[data-glass] [role="menu"],
+  html[data-glass] [role="listbox"],
+  html[data-glass] [role="dialog"] {
+    background-color: rgb(var(--glass-panel-rgb));
+    /* autoprefixer: ignore next */
+    -webkit-backdrop-filter: none;
+    backdrop-filter: none;
+  }
+}
+/* Glass: with Transparency on (linked: while frosted), glass stacked on the page glass (the side menu, workspace panels)
+   is thinner: the page glass under it already covers part of the picture. glass.ts works
+   the fill out so text still passes over pure black or pure white beneath both layers. Glass
+   over someone's work (data-glass-over-work) and menus and dialogs, which can open over
+   anything, keep the full fill. */
+html[data-glass][data-glass-thin] :is(.bg-ui-background, .bg-background) :is(.bg-sidebar, [class*="bg-ui-panel"], .bg-background):not([data-glass-over-work]):not([role="menu"]):not([role="dialog"]):not([role="listbox"]) {
+  background-color: rgb(var(--glass-panel-rgb) / var(--glass-fill-stacked));
+}
+/* Desktop: the top bar is fixed over the full-screen page glass but isn't inside it, so the rule
+   above misses it. It is stacked glass all the same, so Transparency thins it too. */
+html[data-glass][data-glass-thin] header.fixed[class*="bg-ui-panel"] {
+  background-color: rgb(var(--glass-panel-rgb) / var(--glass-fill-stacked));
+}
+/* Glass in workspaces (html[data-glass-match], the owner's choice): inside a workspace, every surface takes the
+   menu's look while frosted: the floating tools and glass over work cover as much as the menu
+   does in all (--glass-fill-total), and the 3D scene itself (grid, floor and objects) turns as
+   see-through as the menu over the page glass under it (--glass-fill-stacked). The page glass
+   is already thinner than the menu and stays as it is. Readability over
+   work is not promised here. */
+html[data-glass][data-glass-thin][data-glass-match][data-glass-workspace] :is(.glass, [data-glass-over-work]) {
+  background-color: rgb(var(--glass-panel-rgb) / var(--glass-fill-total)) !important;
