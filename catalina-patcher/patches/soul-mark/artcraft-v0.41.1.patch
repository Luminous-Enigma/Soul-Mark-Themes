+    linear-gradient(rgb(var(--st-neon-glow-rgb) / var(--st-neon-menu-grid)) 1px, transparent 1px),
+    linear-gradient(90deg, rgb(var(--st-neon-glow-rgb) / var(--st-neon-menu-grid)) 1px, transparent 1px);
+  background-size: 32px 32px;
+  background-attachment: fixed;
+}
+html[data-neon-menu-grid][data-gradient] .bg-sidebar,
+html[data-neon-menu-grid][data-gradient] .bg-ui-panel,
+html[data-neon-menu-grid][data-gradient] .bg-ui-modal,
+html[data-neon-menu-grid][data-gradient] [role="menu"],
+html[data-neon-menu-grid][data-gradient] [role="dialog"],
+html[data-neon-menu-grid][data-gradient] .bg-sidebar .bg-ui-sunken,
+html[data-neon-menu-grid][data-gradient] .bg-sidebar .bg-ui-controls,
+html[data-neon-menu-grid][data-gradient] .bg-ui-modal .bg-ui-sunken,
+html[data-neon-menu-grid][data-gradient] .bg-ui-modal .bg-ui-controls,
+html[data-neon-menu-grid][data-gradient] [role="menu"] .bg-ui-sunken,
+html[data-neon-menu-grid][data-gradient] [role="menu"] .bg-ui-controls,
+html[data-neon-menu-grid][data-gradient] [role="dialog"] .bg-ui-sunken,
+html[data-neon-menu-grid][data-gradient] [role="dialog"] .bg-ui-controls {
