{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/Luminous-Enigma/Soul-Mark-Themes/main/soul-mark/v2/schema/theme.schema.json",
  "title": "Soul Mark theme file",
  "description": "A theme as its few chosen colors (its seeds). Every other color is derived from these and checked for readability (WCAG AA) by the engine. \"solid-tones\" is Soul Mark: Solid Tones; \"gradients\" is Soul Mark: Gradients; \"neon\" is Soul Mark: Neon; \"glass\" is Soul Mark: Glass (no background color: the glass is the background).",
  "type": "object",
  "required": [
    "theme",
    "seeds"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "name": {
      "type": "string",
      "description": "A name for the theme."
    },
    "theme": {
      "enum": [
        "solid-tones",
        "gradients",
        "neon",
        "glass"
      ]
    },
    "seeds": {
      "type": "object",
      "required": [
        "accent"
      ],
      "additionalProperties": false,
      "properties": {
        "background": {
          "$ref": "#/$defs/hex",
          "description": "The background (every theme but Glass); for a gradient, color 1, at the top."
        },
        "accent": {
          "$ref": "#/$defs/hex",
          "description": "Buttons, selections and highlights."
        },
        "tint": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "default": 0.5,
          "description": "How strongly panels step off the background."
        },
        "character": {
          "enum": [
            "soft",
            "warm",
            "cool"
          ],
          "default": "soft",
          "description": "The tone of the text, which is always chosen for readability."
        },
        "guard": {
          "type": "boolean",
          "default": true,
          "description": "The readability guard. False uses the colors exactly as picked."
        },
        "color2": {
          "$ref": "#/$defs/hex",
          "description": "Gradients: what color 1 fades to. Neon: an optional fade, top to bottom. Never the same as the background."
        },
        "color3": {
          "$ref": "#/$defs/hex",
          "description": "Gradients only: an optional third color after color 2."
        },
        "shape": {
          "enum": [
            "vertical",
            "elliptical"
          ],
          "default": "vertical",
          "description": "Gradients only: top to bottom, or an elliptical glow from the top."
        },
        "glow": {
          "$ref": "#/$defs/hex",
          "description": "Neon only: the glowing outline color on panels and buttons."
        },
        "strength": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "default": 0.6,
          "description": "Neon only: how strong the glow and grid are."
        },
        "grid": {
          "type": "boolean",
          "default": true,
          "description": "Neon only: a faint grid behind everything."
        },
        "textGlow": {
          "type": "boolean",
          "default": false,
          "description": "Neon only: every text tinted toward the glow with a soft halo, kept readable by the guard."
        },
        "menuGrid": {
          "type": "boolean",
          "default": false,
          "description": "Neon only: the grid also runs through menus and dialogs. Needs grid."
        },
        "kind": {
          "enum": [
            "light",
            "dark"
          ],
          "description": "Glass: light (clear) or dark (charcoal) glass."
        },
        "picture": {
          "type": "string",
          "pattern": "^[a-z0-9-]{1,32}$",
          "description": "Glass: the picture behind the glass, a starter's id or \"custom\". Readability never depends on it."
        },
        "frost": {
          "type": "number",
          "minimum": 0,
          "maximum": 100,
          "default": 30,
          "description": "Glass: the frost (blur), 0 to 100."
        },
        "frostOn": {
          "type": "boolean",
          "default": true,
          "description": "Glass: frost on or off."
        },
        "transparency": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "default": 0.09,
          "description": "Glass: how much the menus' and panels' own glass covers. The guard raises it only as far as their text needs."
        },
        "linked": {
          "type": "boolean",
          "default": true,
          "description": "Glass: Transparency applies only while frosted."
        },
        "darkened": {
          "type": "number",
          "minimum": 0,
          "maximum": 100,
          "default": 50,
          "description": "Glass: the smoky tint, 0 to 100, used when darkOn."
        },
        "darkOn": {
          "type": "boolean",
          "default": false,
          "description": "Glass: Darkened on or off."
        },
        "lines": {
          "enum": [
            "light",
            "dark"
          ],
          "default": "light",
          "description": "Glass: the 3D editor's guide lines."
        },
        "fill": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Glass, guard off only: the page glass's fill as picked."
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "theme": {
            "const": "gradients"
          }
        }
      },
      "then": {
        "properties": {
          "seeds": {
            "required": [
              "color2"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "theme": {
            "const": "solid-tones"
          }
        }
      },
      "then": {
        "properties": {
          "seeds": {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "color2"
                  ]
                },
                {
                  "required": [
                    "color3"
                  ]
                },
                {
                  "required": [
                    "shape"
                  ]
                }
              ]
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "theme": {
            "const": "neon"
          }
        }
      },
      "then": {
        "properties": {
          "seeds": {
            "required": [
              "glow"
            ],
            "not": {
              "anyOf": [
                {
                  "required": [
                    "color3"
                  ]
                },
                {
                  "properties": {
                    "shape": {
                      "const": "elliptical"
                    }
                  },
                  "required": [
                    "shape"
                  ]
                }
              ]
            }
          }
        }
      },
      "else": {
        "properties": {
          "seeds": {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "glow"
                  ]
                },
                {
                  "required": [
                    "strength"
                  ]
                },
                {
                  "required": [
                    "grid"
                  ]
                },
                {
                  "required": [
                    "textGlow"
                  ]
                },
                {
                  "required": [
                    "menuGrid"
                  ]
                }
              ]
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "theme": {
            "const": "glass"
          }
        }
      },
      "then": {
        "properties": {
          "seeds": {
            "required": [
              "kind",
              "accent"
            ],
            "not": {
              "anyOf": [
                {
                  "required": [
                    "background"
                  ]
                },
                {
                  "required": [
                    "color2"
                  ]
                },
                {
                  "required": [
                    "color3"
                  ]
                },
                {
                  "required": [
                    "shape"
                  ]
                },
                {
                  "required": [
                    "glow"
                  ]
                },
                {
                  "required": [
                    "strength"
                  ]
                },
                {
                  "required": [
                    "grid"
                  ]
                },
                {
                  "required": [
                    "textGlow"
                  ]
                },
                {
                  "required": [
                    "menuGrid"
                  ]
                },
                {
                  "required": [
                    "tint"
                  ]
                },
                {
                  "required": [
                    "character"
                  ]
                }
              ]
            }
          }
        }
      },
      "else": {
        "properties": {
          "seeds": {
            "required": [
              "background"
            ],
            "not": {
              "anyOf": [
                {
                  "required": [
                    "kind"
                  ]
                },
                {
                  "required": [
                    "picture"
                  ]
                },
                {
                  "required": [
                    "frost"
                  ]
                },
                {
                  "required": [
                    "frostOn"
                  ]
                },
                {
                  "required": [
                    "transparency"
                  ]
                },
                {
                  "required": [
                    "linked"
                  ]
                },
                {
                  "required": [
                    "darkened"
                  ]
                },
                {
                  "required": [
                    "darkOn"
                  ]
                },
                {
                  "required": [
                    "lines"
                  ]
                },
                {
                  "required": [
                    "fill"
                  ]
                }
              ]
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "hex": {
      "type": "string",
      "pattern": "^#[0-9A-Fa-f]{6}$"
    }
  }
}
