+html[data-neon="grid"] div:has(> div > .konvajs-content) {
+  background-color: var(--st-bg);
+  background-image: var(--st-gradient-page, none);
+  background-size: auto;
+  background-attachment: fixed;
+}
+
+/* Soul Mark: Neon's two switches. Glowing text: every text gets a soft halo in the glow color,
+   in three layers whose combined strongest point is the halo the engine measured
+   (--st-neon-text-halo per layer); the text colors themselves are tinted by the engine
+   (--st-white-rgb, --st-fg). Filled buttons keep their own labels, untinted and without a halo,
+   since the engine measures text on the page and panels, not on buttons. */
