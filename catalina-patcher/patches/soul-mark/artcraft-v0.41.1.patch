diff --git a/frontend/apps/artcraft/app/src/index.tsx b/frontend/apps/artcraft/app/src/index.tsx
index 6c433fc..3db1309 100644
--- a/frontend/apps/artcraft/app/src/index.tsx
+++ b/frontend/apps/artcraft/app/src/index.tsx
@@ -13,6 +13,21 @@ import { SyncStorytellerApiConfig } from "./api/SyncStorytellerApiConfig";
 import { posthog } from "posthog-js";
 import { SoundManager } from "@storyteller/soundboard";
 import { useModelsStore } from "@storyteller/tauri-api";
+import { setAppWorkspace, startTheming } from "@storyteller/ui-settings-modal";
+import { useTabStore } from "./pages/Stores/TabState";
+
+/** Desktop tabs that are workspaces, by the web app's names (Soul Mark's workspace.ts). */
+const TAB_WORKSPACES: Record<string, string> = {
+  "3D": "edit-3d",
+  "2D": "edit-image",
+  VIDEO_EDITOR: "video-editor",
+  MOODBOARD: "moodboard",
+  BACKGROUND_CHANGE: "background-change",
+  VIDEO_FRAME_EXTRACTOR: "frame-extractor",
+  REMOVE_BACKGROUND: "media",
+  IMAGE_WATERMARK_REMOVAL: "media",
+  VIDEO_WATERMARK_REMOVAL: "media",
+};
 
 // TODO(bt,2025-04-19): Make these configurable
 const ENV = {
@@ -51,20 +66,15 @@ const GlobalSettingsManager = ({ env }: { env: Record<string, string> }) => {
     PostHogInit();
   }, [env]);
 
-  // Apply stored theme early on mount
+  // Apply the stored theme early on mount: ArtCraft's own (st-theme), or a Soul Mark theme
+  // (catalina-patcher's Soul Mark patch), and follow every change after.
   useEffect(() => {
-    const key = "st-theme";
-    const value = (localStorage.getItem(key) || "gray").trim();
-    const allowed = ["light", "gray", "black", "aurora", "sunset", "gradient"];
-    const normalized = value === "gradient" ? "aurora" : value;
-    const theme = allowed.includes(value) ? (normalized as string) : "gray";
-    const root = document.documentElement;
-    const toRemove: string[] = [];
-    root.classList.forEach((c) => {
-      if (c.startsWith("theme-")) toRemove.push(c);
-    });
-    toRemove.forEach((c) => root.classList.remove(c));
-    root.classList.add(`theme-${theme}`);
+    startTheming();
+    // Which tool is open, for Neon's grid and Glass's workspaces (the desktop has one address
+    // for every tool, so the tab store says instead).
+    const follow = (tab: string) => setAppWorkspace(TAB_WORKSPACES[tab] ?? null);
+    follow(useTabStore.getState().activeTabId);
+    return useTabStore.subscribe((s) => follow(s.activeTabId));
   }, []);
 
   /// Initizations that run only once on 1ST mount ///
diff --git a/frontend/apps/artcraft/app/src/styles/base.css b/frontend/apps/artcraft/app/src/styles/base.css
index 2df03b0..0343765 100644
--- a/frontend/apps/artcraft/app/src/styles/base.css
+++ b/frontend/apps/artcraft/app/src/styles/base.css
@@ -861,3 +861,309 @@ img {
     margin-inline: 32px;
   }
 }
+
+/* ===================== SOUL MARK (catalina-patcher's Soul Mark patch) ===================== */
+/* Soul Mark's own variables, as "R G B" so Tailwind can add alpha. These defaults are ArtCraft's
+   own colors, so ArtCraft's five themes look exactly as before; a Soul Mark theme sets them on
+   <html> (libs/components/settings-modal/src/lib/soul-mark/theme-store.ts). */
+:root {
+  --st-white-rgb: 255 255 255;
+  --st-black-rgb: 0 0 0;
+  --st-text-rgb: 242 241 238;
+  --st-bg-rgb: 18 19 22;
+  --st-panel-rgb: 16 16 20;
+  --st-control-rgb: 30 31 34;
+  --st-sunken-rgb: 6 6 7;
+  --st-scroll-track-rgb: 11 11 12;
+  --st-scroll-thumb-rgb: 44 44 47;
+  --st-accent-rgb: 45 129 255;
+  --st-accent-300-rgb: 142 199 255;
+  --st-accent-400-rgb: 89 167 255;
+  --st-accent-600-rgb: 27 99 245;
+  --st-accent-700-rgb: 20 78 225;
+  --st-accent-ink-rgb: 116 170 255;
+  --st-accent-text-rgb: 45 129 255;
+  --st-accent-line-rgb: 45 129 255;
+  --st-text-fade: 1;
+}
+
+/* While a Soul Mark theme is on: the page, scrollbars, selection and focus follow it. */
+html[data-theme="soul-mark"],
+html[data-theme="gradients"],
+html[data-theme="neon"] {
+  color-scheme: var(--st-color-scheme, dark);
+  scrollbar-color: rgb(var(--st-scroll-thumb-rgb)) rgb(var(--st-scroll-track-rgb));
+}
+html[data-theme="soul-mark"] body,
+html[data-theme="gradients"] body,
+html[data-theme="neon"] body {
+  color: rgb(var(--st-text-rgb));
+  background-color: rgb(var(--st-bg-rgb));
+}
+html[data-theme="soul-mark"] *::-webkit-scrollbar-track,
+html[data-theme="gradients"] *::-webkit-scrollbar-track,
+html[data-theme="neon"] *::-webkit-scrollbar-track {
+  background: rgb(var(--st-scroll-track-rgb));
+}
+html[data-theme="soul-mark"] *::-webkit-scrollbar-thumb,
+html[data-theme="gradients"] *::-webkit-scrollbar-thumb,
+html[data-theme="neon"] *::-webkit-scrollbar-thumb {
+  background-color: rgb(var(--st-scroll-thumb-rgb));
+  border: 2px solid rgb(var(--st-scroll-track-rgb));
