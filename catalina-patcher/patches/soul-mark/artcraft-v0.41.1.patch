+html[data-theme="gradients"] ::selection,
+html[data-theme="neon"] ::selection {
+  background: rgb(var(--st-accent-rgb));
+  color: rgb(var(--st-white-rgb));
+}
+html[data-theme="soul-mark"] .icon-auto-contrast,
+html[data-theme="gradients"] .icon-auto-contrast,
+html[data-theme="neon"] .icon-auto-contrast {
+  filter: var(--st-icon-filter, invert(1));
+}
+html[data-theme="soul-mark"] .bg-ui-panel-gradient,
+html[data-theme="gradients"] .bg-ui-panel-gradient,
+html[data-theme="neon"] .bg-ui-panel-gradient {
+  background: rgb(var(--st-panel-rgb));
+}
+
+/* The rest is Soul Mark's own rules from ArtCraft's web app (Gradients, Neon, Glass), unchanged:
+   each applies only while its theme is on. */
+/* Soul Mark gradients. Set only while a gradient theme is on (html[data-gradient]);
+   the variables hold gradients built from composed hex colors, never typed text.
+   The page's gradient is fixed to the window, so every full-page area shows one
+   continuous gradient; panels, the side menu and dialogs carry their own. Controls and
+   see-through fills (bg-ui-controls, bg-ui-panel/95 ...) stay solid. */
+html[data-gradient] body,
+html[data-gradient] .bg-ui-background,
+html[data-gradient] .bg-background {
+  background-image: var(--st-gradient-page);
+  background-attachment: fixed;
+}
+html[data-gradient] .bg-ui-panel,
+html[data-gradient] .bg-ui-modal,
+html[data-gradient] .bg-sidebar,
+html[data-gradient] .bg-ui-panel-gradient {
+  background-image: var(--st-gradient-panel);
+}
+
+/* Soul Mark: Neon. Set only while Neon is on (html[data-neon]); the variables are a composed
+   RGB triplet and two opacities, never typed text. The glow is a 1px line in the glow color
+   (measured at 3:1 against the page and panels) and a soft bloom around panels, dialogs, the
+   side menu and filled buttons; the bloom's strongest point is the tint the engine measured
+   text against. It never sits under or replaces text color. The grid is a faint line every
+   32px behind the page, also measured under text, and stays off on pages where people work on
+   a picture, video or 3D scene (html[data-workspace], set in theme/workspace.ts: off where an editor draws its own grid, dimmed where it doesn't). */
+html[data-neon] .bg-ui-panel,
+html[data-neon] .bg-ui-modal,
+html[data-neon] .bg-sidebar {
+  box-shadow:
+    0 0 0 1px rgb(var(--st-neon-glow-rgb)),
+    0 0 22px 2px rgb(var(--st-neon-glow-rgb) / var(--st-neon-bloom));
+}
+html[data-neon] .bg-primary {
+  box-shadow:
+    0 0 0 1px rgb(var(--st-neon-glow-rgb)),
+    0 0 14px 1px rgb(var(--st-neon-glow-rgb) / var(--st-neon-bloom));
+}
+/* The grid line's color: full strength, dimmed in an editor without a grid of its own, and none
+   at all in an editor that draws its own (theme/workspace.ts sets html[data-workspace]). */
+html[data-neon="grid"] {
+  --st-neon-grid-line: rgb(var(--st-neon-glow-rgb) / var(--st-neon-grid));
+}
+html[data-neon="grid"][data-workspace="dim"] {
+  --st-neon-grid-line: rgb(var(--st-neon-glow-rgb) / calc(var(--st-neon-grid) * 0.4));
+}
+html[data-neon="grid"]:not([data-workspace="off"]) body,
+html[data-neon="grid"]:not([data-workspace="off"]) .bg-ui-background,
+html[data-neon="grid"]:not([data-workspace="off"]) .bg-background {
+  background-image:
+    linear-gradient(var(--st-neon-grid-line) 1px, transparent 1px),
+    linear-gradient(90deg, var(--st-neon-grid-line) 1px, transparent 1px);
+  background-size: 32px 32px;
+  background-attachment: fixed;
+}
+html[data-neon="grid"][data-gradient]:not([data-workspace="off"]) body,
+html[data-neon="grid"][data-gradient]:not([data-workspace="off"]) .bg-ui-background,
+html[data-neon="grid"][data-gradient]:not([data-workspace="off"]) .bg-background {
+  background-image:
+    linear-gradient(var(--st-neon-grid-line) 1px, transparent 1px),
+    linear-gradient(90deg, var(--st-neon-grid-line) 1px, transparent 1px),
+    var(--st-gradient-page);
+  background-size: 32px 32px, 32px 32px, auto;
+}
+/* A window that draws its own grid shows none of ours: it repaints the page beneath, the same
+   fade pinned to the window, so it lines up with the page around it. The windows are found by
+   what they hold, so the editors themselves stay untouched:
+   - the video editor's preview (its grid guides): the one panel with this set of classes;
+   - the image editor's canvas (a checkerboard behind see-through parts): the box around a
+     Konva drawing surface. */
