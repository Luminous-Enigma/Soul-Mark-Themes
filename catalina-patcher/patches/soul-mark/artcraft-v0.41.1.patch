+
+/* Soul Mark: Glass (theme/glass-adapter.ts sets html[data-glass]; theme/glass.ts decides the values). A picture sits behind
+   the whole app, under an optional smoke (Darkened). Every surface is glass: a see-through fill
+   in the glass color, at the least opacity that keeps body text at AA over pure black and pure
+   white behind it, plus the Frost blur. The fill alone passes, so without backdrop-filter, or
+   with less transparency asked for, the glass simply turns solid. */
+html[data-glass] body {
+  background-color: rgb(var(--glass-smoke-rgb));
+  background-image:
+    linear-gradient(rgb(var(--glass-smoke-rgb) / var(--glass-smoke)), rgb(var(--glass-smoke-rgb) / var(--glass-smoke))),
+    var(--glass-picture);
+  background-size: cover;
+  background-position: center;
+  background-attachment: fixed;
+}
+html[data-glass] .bg-ui-background,
+html[data-glass] .bg-background {
