+html[data-neon-text] .bg-primary,
+html[data-neon-text] .bg-primary * {
+  --st-white-rgb: var(--st-neon-label-rgb);
+  text-shadow: none;
+}
+/* The grid on menus: the side menu, drop-down menus and dialogs carry the page's grid, pinned to
+   the window so its lines continue from the page, at the strength the engine measured text in
+   them against (--st-neon-menu-grid), down to the fields and controls inside them (the engine
+   measures their text with the grid behind it too). Unlike the page's grid, it ignores html[data-workspace]:
+   menus keep it on every page, editors included (the owner's call). */
+html[data-neon-menu-grid] .bg-sidebar,
+html[data-neon-menu-grid] .bg-ui-panel,
+html[data-neon-menu-grid] .bg-ui-modal,
+html[data-neon-menu-grid] [role="menu"],
+html[data-neon-menu-grid] [role="dialog"],
+html[data-neon-menu-grid] .bg-sidebar .bg-ui-sunken,
+html[data-neon-menu-grid] .bg-sidebar .bg-ui-controls,
+html[data-neon-menu-grid] .bg-ui-modal .bg-ui-sunken,
+html[data-neon-menu-grid] .bg-ui-modal .bg-ui-controls,
+html[data-neon-menu-grid] [role="menu"] .bg-ui-sunken,
+html[data-neon-menu-grid] [role="menu"] .bg-ui-controls,
+html[data-neon-menu-grid] [role="dialog"] .bg-ui-sunken,
