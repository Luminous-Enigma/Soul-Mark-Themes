+  -webkit-backdrop-filter: blur(var(--glass-blur)) saturate(1.15);
+  backdrop-filter: blur(var(--glass-blur)) saturate(1.15);
+}
+/* 3D: the scene's background is cleared to see-through (glass-adapter.ts), so its lines keep full
+   strength; the glass behind the scene takes the menu's fill, and every line gets a thin outline
+   in the line color so the grid, floor and camera read bolder over the picture. */
+html[data-glass][data-glass-thin][data-glass-match][data-glass-workspace="edit-3d"] :has(> canvas) {
+  background-color: rgb(var(--glass-panel-rgb) / var(--glass-fill-stacked));
+}
+html[data-glass][data-glass-thin][data-glass-match][data-glass-workspace="edit-3d"] canvas {
+  filter: drop-shadow(0 0 0.6px rgb(var(--glass-line-rgb) / 0.9)) drop-shadow(0 0 0.6px rgb(var(--glass-line-rgb) / 0.6));
+}
