{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/Luminous-Enigma/Soul-Mark-Themes/main/soul-mark/v2/schema/composed.schema.json",
  "title": "Soul Mark composed theme",
  "description": "Every color of a theme, as `soul-mark export --format json` writes it. Derived from the seeds; text colors are always readable with the guard on.",
  "type": "object",
  "required": [
    "theme",
    "code",
    "seeds",
    "tokens",
    "scheme",
    "textFade"
  ],
  "additionalProperties": false,
  "properties": {
    "theme": {
      "enum": [
        "Soul Mark: Solid Tones",
        "Soul Mark: Gradients",
        "Soul Mark: Neon",
        "Soul Mark: Glass"
      ]
    },
    "name": {
      "type": "string"
    },
    "code": {
      "type": "string",
      "pattern": "^SM[1234]-"
    },
    "seeds": {
      "$ref": "theme.schema.json#/properties/seeds"
    },
    "tokens": {
      "type": "object",
      "description": "The composed colors by role: background, panel, controls, sunken, text, ink, deep, the accent and its shades, and scrollbars.",
      "required": [
        "background",
        "panel",
        "controls",
        "sunken",
        "text",
        "ink",
        "deep",
        "accent",
        "accent-text",
        "accent-line"
      ],
      "additionalProperties": {
        "type": "string",
        "pattern": "^#[0-9A-F]{6}$"
      }
    },
    "scheme": {
      "enum": [
        "dark",
        "light"
      ],
      "description": "dark means light text on a dark ground."
    },
    "textFade": {
      "type": "number",
      "minimum": 0.4,
      "maximum": 1,
      "description": "How see-through faded text may be; lower is stronger."
    },
    "gradient": {
      "type": "object",
      "required": [
        "shape",
        "stops",
        "panelStops",
        "css"
      ],
      "additionalProperties": false,
      "properties": {
        "shape": {
          "enum": [
            "vertical",
            "elliptical"
          ]
        },
        "stops": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "panelStops": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "css": {
          "type": "string"
        }
      }
    },
    "neon": {
      "type": "object",
      "required": [
        "glow",
        "bloom",
        "grid",
        "css"
      ],
      "additionalProperties": false,
      "description": "Soul Mark: Neon only.",
      "properties": {
        "glow": {
          "type": "string",
          "pattern": "^#[0-9A-F]{6}$"
        },
        "bloom": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "grid": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "css": {
          "type": "object",
          "description": "The CSS variables Neon adds: the glow as RGB, and the bloom and grid as opacities.",
          "additionalProperties": {
            "type": "string"
          }
        },
        "text": {
          "type": "object",
          "required": [
            "tint",
            "halo"
          ],
          "additionalProperties": false,
          "properties": {
            "tint": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "halo": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          }
        },
        "menuGrid": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "glass": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "glass",
        "picture",
        "fill",
        "stackedFill",
        "overWorkFill",
        "thin",
        "blur",
        "smoke",
        "textFade",
        "lines",
        "css"
      ],
      "description": "Soul Mark: Glass only: how much of the picture each layer covers (the page, menus and panels, glass over work), whether Transparency applies now, the blur in pixels, the smoke, and the 3D line color.",
      "properties": {
        "kind": {
          "enum": [
            "light",
            "dark"
          ]
        },
        "glass": {
          "$ref": "#/$defs/hex"
        },
        "picture": {
          "type": "string"
        },
        "fill": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "stackedFill": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "overWorkFill": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "thin": {
          "type": "boolean"
        },
        "blur": {
          "type": "number",
          "minimum": 0
        },
        "smoke": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "textFade": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "lines": {
          "$ref": "#/$defs/hex"
        },
        "css": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "description": "The CSS variables Glass adds to the base theme's."
        }
      }
    }
  },
  "$defs": {
    "hex": {
      "type": "string",
      "pattern": "^#[0-9A-Fa-f]{6}$"
    }
  }
}
